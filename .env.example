# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN_TABLE=your-telegram-bot-token

# OpenAI API key — powers the CRUD agent, the table_plan ingestion, the compare
# plan, and tier-3 residual key matching. https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Your Telegram numeric chat id (the owner, for failure alerts). Comma-separate
# multiple ids. Ask @userinfobot for yours.
TELEGRAM_CHAT_ID=000000000

# --- Optional ---------------------------------------------------------------

# Redis connection URL for per-chat wizard/session state. Defaults to localhost.
REDIS_URL=redis://localhost:6379

# Model override (a sensible default is built in; set only to override).
# EXCEL_MODEL=gpt-5.4-mini
